<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>Jellyfin.Plugin.JMSFusionV2</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.JMSFusionV2</RootNamespace>

    <Version>4.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JMSFusionV2</PackageId>
    <Authors>G-grbz;WhatsCS;Contributors</Authors>
    <Company>JMS</Company>
    <Description>
      Independent WhatsCS fork of MonWUI / JMSFusion, originally developed by G-grbz and upstream contributors.
      Inject custom JS into Jellyfin web UI via in-memory transform (no file writes), with FileProvider wrapping;
      fallback to middleware and optional index.html patch. Serves /slider from external dir or embedded Resources/slider.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Common"    Version="10.11.0" />
    <PackageReference Include="Jellyfin.Data"      Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/**/*" />
    <EmbeddedResource Include="Resources/**/*" />
    <EmbeddedResource Include="RuntimeModules/**/*" />
  </ItemGroup>

  <Target Name="EnsureJavaScriptMinifier" BeforeTargets="MinifyEmbeddedJavaScript"
          Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/terser/package.json') Or !Exists('$(MSBuildProjectDirectory)/node_modules/esbuild/package.json')">
    <Message Text="Installing pinned JavaScript build dependencies..." Importance="high" />
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="MinifyEmbeddedJavaScript" BeforeTargets="AssignTargetPaths;_CalculateEmbeddedFilesManifestInputs" DependsOnTargets="EnsureJavaScriptMinifier">
    <PropertyGroup>
      <MinifiedAssetsDir>$(IntermediateOutputPath)minified-assets</MinifiedAssetsDir>
    </PropertyGroup>
    <Message Text="Minifying embedded JavaScript assets..." Importance="high" />
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/tools/minify-assets.mjs&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(MinifiedAssetsDir)&quot;" />
    <ItemGroup>
      <_JmsGeneratedBundle Include="$(MinifiedAssetsDir)/Resources/slider/dist/**/*.js" />
      <EmbeddedResource Include="@(_JmsGeneratedBundle)">
        <Link>Resources/slider/dist/%(_JmsGeneratedBundle.RecursiveDir)%(_JmsGeneratedBundle.Filename)%(_JmsGeneratedBundle.Extension)</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="UpdateMetaJson"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish">
    <Message Text="Updating meta.json (timestamp &amp; version &amp; imagePath)..." Importance="high" />
    <Exec Command="bash ./update_meta.sh &quot;$(Version)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
